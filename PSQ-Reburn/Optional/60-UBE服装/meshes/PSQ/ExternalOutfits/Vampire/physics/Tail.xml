	<!-- cloth -->

	
	<bone-default>
		<margin-multiplier>0.01</margin-multiplier>
	</bone-default>
	
	
	<bone name="pp1 1"/>


    <bone-default>
		<mass>1</mass>
		<inertia x="10" y="10" z="10" />
		<centerOfMassTransform>
			<basis x="0" y="0" z="0" w="1" />
			<origin x="0" y="0" z="0" />
		</centerOfMassTransform>
		<linearDamping>0.97</linearDamping>
		<angularDamping>0.92</angularDamping>
		<margin-multiplier>0.3</margin-multiplier>
		<gravity-factor>0.3</gravity-factor>
		<friction>0</friction>
		<restitution>0</restitution>
	</bone-default>
	
	<bone name="pp1 2"/>   
	
	<bone name="pp1 3"/>

	<bone name="pp1 4"/>

   
	<bone-default>
	<linearDamping>0.85</linearDamping>
		<angularDamping>0.7</angularDamping>
		<margin-multiplier>0.9</margin-multiplier>
	</bone-default>

	<bone name="pp1 5"/>

	<bone name="pp1 6"/>
	
	<bone name="pp1 7"/>


	<bone-default>
	<linearDamping>0.9</linearDamping>
		<angularDamping>0.75</angularDamping>
		<margin-multiplier>1.3</margin-multiplier>
	</bone-default>

	<bone name="pp1 8"/>

	<bone name="pp1 9"/>
	
	<bone name="pp1 10"/>

    <bone name="pp1 11"/>
	
	<bone name="pp1 12"/>
	
	<bone name="pp1 13"/>

	
	<generic-constraint-default>
		<frameInB>
			<basis x="0" y="0" z="0" w="1" />
			<origin x="0" y="0" z="0" />
		</frameInB>
		<useLinearReferenceFrameA>false</useLinearReferenceFrameA>
		<linearLowerLimit x="0" y="0" z="0" />
		<linearUpperLimit x="0" y="0" z="0" />
		<angularLowerLimit x="-0.021" y="0.06" z="-0.052" />
		<angularUpperLimit x="0.021" y="0.1" z="0.052" />
		<linearStiffness x="0" y="0" z="0" />
		<angularStiffness x="0" y="0" z="0" />
		<linearDamping x="0" y="0" z="0" />
		<angularDamping x="0" y="0" z="0" />
		<linearEquilibrium x="0" y="0" z="0" />
		<angularEquilibrium x="0" y="0" z="0" />
	</generic-constraint-default>
        <constraint-group>
		<generic-constraint bodyA="pp1 2" bodyB="pp1 1"/>
		<generic-constraint bodyA="pp1 3" bodyB="pp1 2"/>
		<generic-constraint bodyA="pp1 4" bodyB="pp1 3"/>
		<generic-constraint bodyA="pp1 5" bodyB="pp1 4"/>
		<generic-constraint bodyA="pp1 6" bodyB="pp1 5"/>
		<generic-constraint bodyA="pp1 7" bodyB="pp1 6"/>
		<generic-constraint bodyA="pp1 8" bodyB="pp1 7"/>
		<generic-constraint bodyA="pp1 9" bodyB="pp1 8"/>
		<generic-constraint bodyA="pp1 10" bodyB="pp1 9"/>
		<generic-constraint bodyA="pp1 11" bodyB="pp1 10"/>
		<generic-constraint bodyA="pp1 12" bodyB="pp1 11"/>
		<generic-constraint bodyA="pp1 13" bodyB="pp1 12"/>
	</constraint-group>


	<per-vertex-shape name="Tail">
		<margin>0.7</margin>
		<priority>0</priority>
		<shared>private</shared>
		<tag>h9</tag>
		<can-collide-with-tag>h6</can-collide-with-tag>
		<can-collide-with-tag>ground</can-collide-with-tag>
		<no-collide-with-tag>h9</no-collide-with-tag>
		<weight-threshold bone="pp1 2">1</weight-threshold>		
		<weight-threshold bone="pp1 3">1</weight-threshold>
        <weight-threshold bone="pp1 4">0.7</weight-threshold>
		<weight-threshold bone="pp1 5">0.7</weight-threshold>
        <weight-threshold bone="pp1 6">0.7</weight-threshold>
		<weight-threshold bone="pp1 7">0.7</weight-threshold>
        <weight-threshold bone="pp1 8">0.7</weight-threshold>
		<weight-threshold bone="pp1 9">0.7</weight-threshold>
		<weight-threshold bone="pp1 10">0.7</weight-threshold>
        <weight-threshold bone="pp1 11">0.7</weight-threshold>
		<weight-threshold bone="pp1 12">0.7</weight-threshold>
		<weight-threshold bone="pp1 13">0.7</weight-threshold>
