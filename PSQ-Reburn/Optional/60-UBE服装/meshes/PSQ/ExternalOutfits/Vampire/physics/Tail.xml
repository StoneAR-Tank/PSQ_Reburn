	<bone name="NPC L Toe0 [LToe]"/>
	<bone name="NPC R Toe0 [RToe]"/>

	
	<per-triangle-shape name="uup">
		<margin>0.6</margin>
		<priority>100</priority>
		<penetration>1</penetration>
		<shared>private</shared>
		<tag>h6</tag>
		<can-collide-with-tag>h9</can-collide-with-tag>
		<no-collide-with-tag>ground</no-collide-with-tag>
        <no-collide-with-tag>h6</no-collide-with-tag>	
		<weight-threshold bone="NPC Belly">1</weight-threshold>
		<weight-threshold bone="NPC Spine [Spn0]">0.3</weight-threshold>
		<weight-threshold bone="NPC Spine1 [Spn1]">0.3</weight-threshold>
		<weight-threshold bone="NPC Spine2 [Spn2]">1</weight-threshold>
		
		<weight-threshold bone="L Breast01">1</weight-threshold>
		<weight-threshold bone="L Breast02">1</weight-threshold>
		<weight-threshold bone="L Breast03">1</weight-threshold>
		<weight-threshold bone="NPC L Butt">0.1</weight-threshold>
		<weight-threshold bone="NPC L Calf [LClf]">0.3</weight-threshold>
		<weight-threshold bone="NPC L Clavicle [LClv]">1</weight-threshold>
